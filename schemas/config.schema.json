{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Braindead config",
  "type": "object",
  "properties": {
    "youtube_api_key": {
      "type": "string",
      "minLength": 1
    },
    "youtube_api_key_path": {
      "type": "string",
      "minLength": 1,
      "description": "Path to a file containing the YouTube API key. Ignored if youtube_api_key is set."
    },
    "openai_uri": {
      "type": "string",
      "minLength": 1
    },
    "openai_api_key": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "notes_triage_location": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "openai_uri",
    "openai_api_key",
    "notes_triage_location",
    "model"
  ],
  "anyOf": [
    { "required": ["youtube_api_key"] },
    { "required": ["youtube_api_key_path"] }
  ],
  "additionalProperties": false
}
